  "row_count": 72,
  "query": "SELECT region_code,region_name,date_trunc('month',local_date)::date AS month,\n        100.0*sum(eligible_wind_solar_mwh)/nullif(sum(eligible_net_generation_mwh),0) AS wind_solar_pct,\n        100.0*sum(eligible_generation_hours)/sum(scoped_hours) AS eligible_hours_pct\n        FROM v_gold_daily WHERE local_date>='2024-01-01' AND local_date<'2026-01-01' GROUP BY 1,2,3"
}
