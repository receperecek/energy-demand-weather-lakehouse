{
  "datasets": [
    {
      "name": "monthly_demand",
      "displayName": "Monthly demand",
      "query": "SELECT region_code,region_name,date_trunc('month',local_date)::date AS month,\n        avg(complete_day_demand_mwh)/1000 AS mean_day_demand_gwh,count(*) AS complete_days\n        FROM v_gold_daily WHERE demand_day_complete AND local_date>='2024-01-01' AND local_date<'2026-01-01'\n        GROUP BY 1,2,3"
    },
    {
      "name": "hour_profile",
      "displayName": "Local-hour demand pattern",
      "query": "SELECT region_code,region_name,hour_of_day,\n        CASE WHEN day_of_week IN (1,7) THEN 'Weekend' ELSE 'Weekday' END AS day_type,\n        concat(region_name,' / ',CASE WHEN day_of_week IN (1,7) THEN 'Weekend' ELSE 'Weekday' END) AS profile_series,\n        avg(demand_mwh)/1000 AS mean_hour_demand_gwh,count(demand_mwh) AS valid_hours\n        FROM v_gold_hourly WHERE local_date>='2024-01-01' AND local_date<'2026-01-01'\n        GROUP BY 1,2,3,4,5"
    },
    {
      "name": "daily",
      "displayName": "Demand and weather context",
      "query": "SELECT region_code,region_name,local_date,\n        complete_day_demand_mwh/1000 AS demand_gwh,\n        CASE WHEN complete_weather_hours=calendar_hours THEN mean_proxy_temperature_c END AS temperature_c,\n        observed_wind_solar_share*100 AS wind_solar_pct,\n        100.0*eligible_generation_hours/calendar_hours AS share_coverage_pct,\n        high_demand_candidate_hours,demand_day_complete\n        FROM v_gold_daily WHERE local_date>='2024-01-01' AND local_date<'2026-01-01'"
    },
    {
      "name": "monthly_share",
      "displayName": "Energy-weighted generation share",
      "query": "SELECT region_code,region_name,date_trunc('month',local_date)::date AS month,\n        100.0*sum(eligible_wind_solar_mwh)/nullif(sum(eligible_net_generation_mwh),0) AS wind_solar_pct,\n        100.0*sum(eligible_generation_hours)/sum(scoped_hours) AS eligible_hours_pct\n        FROM v_gold_daily WHERE local_date>='2024-01-01' AND local_date<'2026-01-01' GROUP BY 1,2,3"
    },
    {
      "name": "fuel_mix",
      "displayName": "Reported generation by fuel",
      "query": "SELECT region_code,region_name,fuel_code,\n        sum(observed_generation_mwh)/1000 AS generation_gwh,sum(reported_hours) AS reported_hours,\n        sum(negative_generation_hours) AS negative_hours\n        FROM v_gold_fuel_daily WHERE local_date>='2024-01-01' AND local_date<'2026-01-01' GROUP BY 1,2,3"
    },
    {
      "name": "quality",
      "displayName": "Daily source coverage",
      "query": "SELECT region_code,region_name,utc_date,expected_hours,\n        100.0*observed_demand_hours/expected_hours AS demand_coverage_pct,\n        100.0*complete_weather_hours/expected_hours AS weather_coverage_pct,\n        100.0*generation_share_eligible_hours/expected_hours AS share_eligible_pct,\n        max_generation_gap_mwh,invalid_energy_records,negative_generation_records\n        FROM v_gold_quality WHERE utc_date>='2024-01-01' AND utc_date<'2026-01-01'"
    },
    {
      "name": "review",
      "displayName": "Investigation queue",
      "query": "SELECT region_code,region_name,local_date,review_priority,\n        peak_hour_demand_mwh/1000 AS peak_hour_gwh,high_demand_candidate_hours,\n        max_demand_deviation_score,demand_day_complete,complete_weather_hours,calendar_hours\n        FROM v_gold_priority WHERE local_date>='2024-01-01' AND local_date<'2026-01-01'\n        AND review_priority<>'ROUTINE' ORDER BY local_date DESC"
    }
  ],
